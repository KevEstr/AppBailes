// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id        Int      @id // Cédula colombiana (sin autoincrement)
  name      String
  email     String?  @unique
  phone     String   @unique
  avatar    String?
  hasDebt   Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attendances      Attendance[]
  receipts         Receipt[]
  debts            Debt[]
  messagesSent     MassiveMessage[] @relation("MessageRecipients")
  classEnrollments ClassEnrollment[]

  @@map("students")
}

model DanceClass {
  id          Int       @id @default(autoincrement())
  name        String    // Ej: "Salsa Básica", "Bachata Intermedio"
  description String?
  trainerId   Int
  capacity    Int       @default(20)
  price       Float?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  trainer     Trainer           @relation(fields: [trainerId], references: [id])
  schedules   ClassSchedule[]
  sessions    ClassSession[]
  enrollments ClassEnrollment[]

  @@map("classes")
}

model ClassSchedule {
  id        Int       @id @default(autoincrement())
  classId   Int
  dayOfWeek Int       // 0 = Domingo, 1 = Lunes, etc.
  startTime String    // HH:MM formato 24h
  endTime   String    // HH:MM formato 24h
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  danceClass DanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_schedules")
}

model ClassSession {
  id          Int      @id @default(autoincrement())
  classId     Int
  date        DateTime // Fecha específica de la sesión
  startTime   DateTime
  endTime     DateTime
  status      SessionStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  danceClass  DanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@map("class_sessions")
}

model ClassEnrollment {
  id         Int      @id @default(autoincrement())
  studentId  Int
  classId    Int
  enrolledAt DateTime @default(now())
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  danceClass DanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@map("class_enrollments")
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  sessionId Int?             // Nueva relación con sesión de clase
  status    AttendanceStatus
  date      DateTime         @default(now())
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session ClassSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

model Receipt {
  id            Int           @id @default(autoincrement())
  studentId     Int
  amount        Float
  concept       String
  paymentMethod PaymentMethod
  promotion     String?
  notes         String?
  whatsappSent  Boolean       @default(false)
  sentAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model Debt {
  id           Int       @id @default(autoincrement())
  studentId    Int
  amount       Float
  concept      String
  dueDate      DateTime
  isPaid       Boolean   @default(false)
  paidAt       DateTime?
  lastReminder DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("debts")
}

model MassiveMessage {
  id          Int         @id @default(autoincrement())
  type        MessageType
  message     String
  targetGroup String
  sentCount   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  recipients Student[] @relation("MessageRecipients")

  @@map("massive_messages")
}

model Trainer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attendances TrainerAttendance[]
  classes     DanceClass[]

  @@map("trainers")
}

model TrainerAttendance {
  id        Int              @id @default(autoincrement())
  trainerId Int
  status    AttendanceStatus
  date      DateTime         @default(now())
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("trainer_attendances")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  CHANGE_REQUEST
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum MessageType {
  PAYMENT_REMINDER
  TRAINING_REMINDER
  ABSENCE_INQUIRY
  GENERAL
}
