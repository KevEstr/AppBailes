generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id                     String                  @id
  name                   String
  phone                  String
  avatar                 String?
  hasDebt                Boolean                 @default(false)
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  userId                 Int?                    @unique
  attendances            Attendance[]
  classEnrollments       ClassEnrollment[]
  debts                  Debt[]
  financialTransactions  FinancialTransaction[]
  monthlyPayments        MonthlyPayment[]
  paymentForms           PaymentForm[]
  receipts               Receipt[]
  scheduledWhatsAppSends ScheduledWhatsAppSend[]
  schedulerRecipients    SchedulerRecipient[]
  serviceOrders          ServiceOrder[]
  enrollmentData         StudentEnrollmentData?
  studentTransfers       StudentTransfer[]
  user                   User?                   @relation(fields: [userId], references: [id])
  messagesSent           MassiveMessage[]        @relation("MessageRecipients")

  @@index([name])
  @@index([phone])
  @@index([isActive])
  @@index([userId])
  @@map("students")
}

model StudentEnrollmentData {
  id                       Int      @id @default(autoincrement())
  studentId                String   @unique
  documentType             String?
  birthDate                String?
  address                  String?
  addressLatitude          Float?
  addressLongitude         Float?
  neighborhood             String?
  city                     String?  @default("Itagüí")
  hasSisben                Boolean  @default(false)
  eps                      String?
  bloodType                String?
  hasRestrictions          Boolean  @default(false)
  restrictionsDescription  String?
  medicalConditions        String?
  isAdult                  Boolean  @default(true)
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  guardianName             String?
  guardianRelation         String?
  guardianPhone            String?
  monthlyFee               Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  student                  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_enrollment_data")
}

model DanceClass {
  name                 String
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  capacity             Int               @default(20)
  description          String?
  level                ClassLevel        @default(BEGINNER)
  locationId           Int?
  modality             String?
  price                Float?
  sport                SportType         @default(DANCE)
  id                   Int               @id @default(autoincrement())
  trainerId            Int
  enrollments          ClassEnrollment[]
  schedules            ClassSchedule[]
  sessions             ClassSession[]
  location             SportLocation?    @relation(fields: [locationId], references: [id])
  trainer              Trainer           @relation(fields: [trainerId], references: [id])
  studentTransfersFrom StudentTransfer[] @relation("TransferFrom")
  studentTransfersTo   StudentTransfer[] @relation("TransferTo")

  @@map("classes")
}

model SportLocation {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  address   String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  classes   DanceClass[]

  @@map("sport_locations")
}

model ClassSchedule {
  id         Int        @id @default(autoincrement())
  classId    Int
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  danceClass DanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_schedules")
}

model ClassSession {
  id          Int           @id @default(autoincrement())
  classId     Int
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  status      SessionStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  attendances Attendance[]
  danceClass  DanceClass    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_sessions")
}

model ClassEnrollment {
  id         Int        @id @default(autoincrement())
  studentId  String
  classId    Int
  enrolledAt DateTime   @default(now())
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  danceClass DanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([isActive])
  @@index([createdAt])
  @@index([studentId])
  @@index([classId])
  @@map("class_enrollments")
}

model StudentTransfer {
  id            Int        @id @default(autoincrement())
  studentId     String
  fromClassId   Int
  toClassId     Int
  transferredBy Int
  reason        String?
  transferredAt DateTime   @default(now())
  fromClass     DanceClass @relation("TransferFrom", fields: [fromClassId], references: [id])
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  toClass       DanceClass @relation("TransferTo", fields: [toClassId], references: [id])
  user          User       @relation(fields: [transferredBy], references: [id])

  @@index([studentId])
  @@index([fromClassId])
  @@index([toClassId])
  @@index([transferredAt])
  @@map("student_transfers")
}

model Attendance {
  studentId String
  status    AttendanceStatus
  date      DateTime         @default(now())
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sessionId Int?
  id        Int              @id @default(autoincrement())
  session   ClassSession?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

model Receipt {
  studentId     String
  amount        Float
  concept       String
  paymentMethod PaymentMethod
  promotion     String?
  notes         String?
  whatsappSent  Boolean       @default(false)
  sentAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  id            Int           @id @default(autoincrement())
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model Debt {
  studentId    String
  amount       Float
  concept      String
  dueDate      DateTime
  isPaid       Boolean   @default(false)
  paidAt       DateTime?
  lastReminder DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  id           Int       @id @default(autoincrement())
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("debts")
}

model MassiveMessage {
  type        MessageType
  message     String
  targetGroup String
  sentCount   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  id          Int         @id @default(autoincrement())
  recipients  Student[]   @relation("MessageRecipients")

  @@map("massive_messages")
}

model Trainer {
  name        String
  email       String              @unique
  phone       String              @unique
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  id          Int                 @id @default(autoincrement())
  classes     DanceClass[]
  attendances TrainerAttendance[]
  users       User?

  @@map("trainers")
}

model TrainerAttendance {
  status    AttendanceStatus
  date      DateTime         @default(now())
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  id        Int              @id @default(autoincrement())
  trainerId Int
  trainer   Trainer          @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("trainer_attendances")
}

model MonthlyFeeConfig {
  id              Int              @id @default(autoincrement())
  amount          Float
  description     String?
  isActive        Boolean          @default(true)
  validFrom       DateTime         @default(now())
  validUntil      DateTime?
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  monthlyPayments MonthlyPayment[]

  @@map("monthly_fee_configs")
}

model PaymentPeriod {
  id                  Int                  @id @default(autoincrement())
  year                Int
  month               Int
  name                String
  dueDate             DateTime
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  monthlyPayments     MonthlyPayment[]
  paymentForms        PaymentForm[]
  schedulerExecutions SchedulerExecution[]

  @@unique([year, month])
  @@map("payment_periods")
}

model MonthlyPayment {
  id             Int                  @id @default(autoincrement())
  studentId      String
  periodId       Int
  feeConfigId    Int
  expectedAmount Float
  paidAmount     Float?
  status         MonthlyPaymentStatus @default(PENDING)
  paymentDate    DateTime?
  approvedBy     String?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  feeConfig      MonthlyFeeConfig     @relation(fields: [feeConfigId], references: [id])
  period         PaymentPeriod        @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student        Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentForms   PaymentForm[]

  @@unique([studentId, periodId])
  @@map("monthly_payments")
}

model PaymentForm {
  id                      String                   @id @default(cuid())
  studentId               String
  periodId                Int
  monthlyPaymentId        Int
  studentName             String
  amount                  Float
  status                  PaymentFormStatus        @default(ACTIVE)
  expiresAt               DateTime?
  usedAt                  DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  enrollmentPaymentProofs EnrollmentPaymentProof[]
  monthlyPayment          MonthlyPayment           @relation(fields: [monthlyPaymentId], references: [id], onDelete: Cascade)
  period                  PaymentPeriod            @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student                 Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentProofs           PaymentProof[]

  @@map("payment_forms")
}

model PaymentProof {
  id            Int                @id @default(autoincrement())
  formId        String
  payerName     String
  payerPhone    String?
  payerEmail    String?
  amount        Float
  paymentMethod PaymentMethod
  proofImageUrl String
  uploadedAt    DateTime           @default(now())
  status        PaymentProofStatus @default(PENDING)
  reviewedAt    DateTime?
  reviewedBy    String?
  reviewNotes   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  paymentForm   PaymentForm        @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@map("payment_proofs")
}

model EnrollmentPayment {
  id             Int                     @id @default(autoincrement())
  studentId      String                  @unique
  sport          SportType
  expectedAmount Float
  status         EnrollmentPaymentStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(6)
  paymentForms   EnrollmentPaymentForm[]

  @@map("enrollment_payments")
}

model EnrollmentPaymentForm {
  id                  String                      @id @default(cuid())
  studentId           String
  enrollmentPaymentId Int
  studentName         String
  sport               SportType
  amount              Float
  status              EnrollmentPaymentFormStatus @default(ACTIVE)
  expiresAt           DateTime?
  usedAt              DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  enrollmentPayment   EnrollmentPayment           @relation(fields: [enrollmentPaymentId], references: [id], onDelete: Cascade)
  paymentProofs       EnrollmentPaymentProof[]

  @@map("enrollment_payment_forms")
}

model EnrollmentPaymentProof {
  id                      Int                    @id @default(autoincrement())
  formId                  String?
  payerName               String
  payerPhone              String?
  payerEmail              String?
  amount                  Float
  paymentMethod           PaymentMethod
  proofImageUrl           String
  uploadedAt              DateTime               @default(now())
  status                  PaymentProofStatus     @default(PENDING)
  reviewedAt              DateTime?
  reviewedBy              String?
  reviewNotes             String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  paymentType             String?                @default("MONTHLY")
  concept                 String?
  enrollmentPaymentFormId String?
  enrollmentPaymentForm   EnrollmentPaymentForm? @relation(fields: [enrollmentPaymentFormId], references: [id], onDelete: Cascade)
  paymentForm             PaymentForm?           @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@map("enrollment_payment_proofs")
}

model ScheduledWhatsAppSend {
  id            Int                    @id @default(autoincrement())
  studentId     String
  message       String
  scheduledFor  DateTime
  scheduledDate DateTime?
  name          String?
  status        ScheduledMessageStatus @default(PENDING)
  sentAt        DateTime?
  errorMessage  String?
  retryCount    Int                    @default(0)
  maxRetries    Int                    @default(3)
  messageType   String?
  priority      Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  student       Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("scheduled_whatsapp_sends")
}

model PaymentScheduler {
  id              Int                  @id @default(autoincrement())
  name            String
  description     String?
  isActive        Boolean              @default(true)
  dayOfMonth      Int                  @default(1)
  hour            Int                  @default(9)
  minute          Int                  @default(0)
  schedulerType   SchedulerType        @default(MONTHLY_PAYMENT)
  targetFilter    TargetFilter         @default(ALL_ACTIVE)
  customFilter    String?
  lastExecuted    DateTime?
  nextExecution   DateTime?
  totalExecutions Int                  @default(0)
  totalSent       Int                  @default(0)
  totalFailed     Int                  @default(0)
  createdBy       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  executions      SchedulerExecution[]
  recipients      SchedulerRecipient[]

  @@map("payment_schedulers")
}

model SchedulerRecipient {
  id          Int              @id @default(autoincrement())
  schedulerId Int
  studentId   String
  isActive    Boolean          @default(true)
  lastSent    DateTime?
  totalSent   Int              @default(0)
  addedAt     DateTime         @default(now())
  addedBy     String?
  notes       String?
  scheduler   PaymentScheduler @relation(fields: [schedulerId], references: [id], onDelete: Cascade)
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schedulerId, studentId])
  @@map("scheduler_recipients")
}

model SchedulerExecution {
  id             Int                      @id @default(autoincrement())
  schedulerId    Int
  status         SchedulerExecutionStatus @default(PENDING)
  startedAt      DateTime?
  completedAt    DateTime?
  totalMessages  Int                      @default(0)
  sentMessages   Int                      @default(0)
  failedMessages Int                      @default(0)
  periodId       Int?
  errorMessage   String?
  executionLogs  String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  period         PaymentPeriod?           @relation(fields: [periodId], references: [id])
  scheduler      PaymentScheduler         @relation(fields: [schedulerId], references: [id], onDelete: Cascade)

  @@map("scheduler_executions")
}

model User {
  email            String            @unique
  password         String
  role             UserRole          @default(STUDENT)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  trainerId        Int?              @unique
  id               Int               @id @default(autoincrement())
  studentTransfers StudentTransfer[]
  student          Student?
  trainers         Trainer?          @relation(fields: [trainerId], references: [id])

  @@map("users")
}

model Service {
  id            Int             @id @default(autoincrement())
  name          String
  description   String?
  basePrice     Float
  category      ServiceCategory
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  serviceOrders ServiceOrder[]
  serviceRates  ServiceRate[]

  @@map("services")
}

model ServiceRate {
  id         Int         @id @default(autoincrement())
  serviceId  Int
  level      ClassLevel?
  sportType  SportType?
  price      Float
  isDefault  Boolean     @default(false)
  validFrom  DateTime    @default(now())
  validUntil DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_rates")
}

model ServiceOrder {
  id            Int                @id @default(autoincrement())
  studentId     String
  serviceId     Int
  quantity      Int                @default(1)
  unitPrice     Float
  totalAmount   Float
  status        ServiceOrderStatus @default(PENDING)
  scheduledDate DateTime?
  completedDate DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  service       Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments      ServicePayment[]

  @@map("service_orders")
}

model ServicePayment {
  id            Int           @id @default(autoincrement())
  orderId       Int
  amount        Float
  paymentMethod PaymentMethod
  status        PaymentStatus @default(PENDING)
  paymentDate   DateTime?
  reference     String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         ServiceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("service_payments")
}

model FinancialPeriod {
  id           Int                    @id @default(autoincrement())
  year         Int
  month        Int
  startDate    DateTime
  endDate      DateTime
  isClosed     Boolean                @default(false)
  closedAt     DateTime?
  closedBy     String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  reports      FinancialReport[]
  transactions FinancialTransaction[]

  @@unique([year, month])
  @@map("financial_periods")
}

model FinancialTransaction {
  id          Int                 @id @default(autoincrement())
  periodId    Int
  type        TransactionType
  category    TransactionCategory
  amount      Float
  description String
  reference   String?
  date        DateTime            @default(now())
  studentId   String?
  relatedId   Int?
  relatedType String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  period      FinancialPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student     Student?            @relation(fields: [studentId], references: [id])

  @@map("financial_transactions")
}

model FinancialReport {
  id                Int             @id @default(autoincrement())
  periodId          Int
  reportType        ReportType
  totalIncome       Float           @default(0)
  totalExpenses     Float           @default(0)
  netProfit         Float           @default(0)
  monthlyPayments   Float           @default(0)
  servicePayments   Float           @default(0)
  otherIncome       Float           @default(0)
  operatingExpenses Float           @default(0)
  summary           Json?
  generatedAt       DateTime        @default(now())
  generatedBy       String?
  period            FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, reportType])
  @@map("financial_reports")
}

enum EnrollmentPaymentStatus {
  PENDING
  PAID
  CANCELLED
  PENDING_REVIEW
}

enum EnrollmentPaymentFormStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  CHANGE_REQUEST
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum MessageType {
  PAYMENT_REMINDER
  TRAINING_REMINDER
  ABSENCE_INQUIRY
  GENERAL
}

enum MonthlyPaymentStatus {
  PENDING
  PARTIAL_PAID
  PAID
  OVERDUE
  CANCELLED
  PENDING_REVIEW
}

enum PaymentFormStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum SchedulerType {
  MONTHLY_PAYMENT
  DEBT_REMINDER
  OVERDUE_WARNING
  PARTIAL_PAYMENT
  CUSTOM_MESSAGE
}

enum TargetFilter {
  ALL_ACTIVE
  WITH_DEBT
  OVERDUE_PAYMENTS
  PARTIAL_PAYMENTS
  SPECIFIC_STUDENTS
  CUSTOM_FILTER
}

enum ScheduledMessageStatus {
  PENDING
  RUNNING
  SENT
  COMPLETED
  FAILED
  CANCELLED
}

enum SchedulerExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum SportType {
  DANCE
  VOLLEYBALL
}

enum ClassLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ServiceCategory {
  TRAINING
  PRIVATE_CLASS
  WORKSHOP
  EVENT
  EQUIPMENT
  OTHER
}

enum ServiceOrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  REFUNDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  MONTHLY_PAYMENT
  SERVICE_PAYMENT
  EQUIPMENT
  MARKETING
  RENT
  UTILITIES
  SALARIES
  OTHER_INCOME
  OTHER_EXPENSE
}

enum ReportType {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}
