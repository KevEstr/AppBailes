{
  "$schema": "https://railway.app/railway.schema.json",
  "services": [
    {
      "name": "app",
      "build": {
        "builder": "dockerfile",
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "numReplicas": 1,
        "sleepApplication": false,
        "restartPolicyType": "never"
      }
    },
    {
      "name": "session-generator",
      "build": {
        "builder": "dockerfile",
        "dockerfilePath": "Dockerfile.cron"
      },
      "deploy": {
        "numReplicas": 0,
        "sleepApplication": true,
        "restartPolicyType": "never"
      },
      "cron": {
        "schedule": "0 2 * * 0",
        "command": "node scripts/generate-sessions-cron.js"
      }
    }
  ]
}
