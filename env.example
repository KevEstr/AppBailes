# ⚡ CONFIGURACIÓN OPTIMIZADA PARA PARADISE DANCE ACADEMY

# 🔧 DATABASE - CON OPTIMIZACIONES DE PERFORMANCE
# Agrega estos parámetros para connection pooling optimizado:
# connection_limit=10 - Máximo 10 conexiones simultáneas
# pool_timeout=20 - 20 segundos timeout para pool
# connect_timeout=10 - 10 segundos timeout para conectar
DATABASE_URL="postgresql://username:password@localhost:5432/paradise_dance_academy?connection_limit=10&pool_timeout=20&connect_timeout=10"

# 🔐 NEXTAUTH - REQUERIDO PARA OPTIMIZACIONES
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="tu_super_secreto_muy_seguro_cambiar_en_produccion"

# 📱 WHATSAPP API (OPCIONAL)
WHATSAPP_API_URL="https://api.ultramsg.com"
WHATSAPP_TOKEN="tu_token_de_whatsapp"

# 🌐 ENVIRONMENT
NODE_ENV="development"

# ⚡ CONFIGURACIONES DE PERFORMANCE
# Estas variables mejoran el rendimiento en producción
NEXT_TELEMETRY_DISABLED=1
NEXT_SHARP=0

# 📊 ANALYTICS (OPCIONAL)
# ANALYTICS_ID="tu_google_analytics_id"

# 🔧 CONFIGURACIONES ADICIONALES DE BD PARA PRODUCCIÓN
# Para PostgreSQL en producción, también puedes agregar:
# &statement_timeout=30000&idle_in_transaction_session_timeout=60000

# EJEMPLO COMPLETO PARA PRODUCCIÓN:
# DATABASE_URL="postgresql://user:pass@host:5432/db?connection_limit=10&pool_timeout=20&connect_timeout=10&statement_timeout=30000&idle_in_transaction_session_timeout=60000"

# WhatsApp Business API (Meta)
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxxx..."  # Tu token de acceso permanente de Meta
WHATSAPP_PHONE_NUMBER_ID="123456789012345"  # ID del número de teléfono de WhatsApp Business
NEXT_PUBLIC_BASE_URL="https://tudominio.com"  # URL pública de tu aplicación

# Para desarrollo local usa:
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Configuración opcional para WhatsApp
WHATSAPP_VERIFY_TOKEN="tu-verify-token-para-webhooks"  # Solo si usas webhooks
WHATSAPP_APP_SECRET="tu-app-secret-de-meta"  # Solo si usas webhooks

# Otras configuraciones...
RESEND_API_KEY="re_xxxxxxxx"
UPLOADTHING_SECRET="sk_live_xxxxxxxx"
UPLOADTHING_APP_ID="xxxxxxxx" 